<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_ok" android:tint="@color/widget_accent" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="@color/widget_on" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_on_variant" android:contentDescription="@string/widget_refresh"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cell_pc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_tile">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/icon_pc" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_pc" android:tint="@color/widget_accent" android:contentDescription="@null"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_pc" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/value_pc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/widget_on" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/sub_pc" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cell_storage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_tile">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/icon_storage" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_storage" android:tint="@color/widget_accent" android:contentDescription="@null"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_storage" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/value_storage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/widget_on" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/sub_storage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cell_network" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_tile">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/icon_network" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_network" android:tint="@color/widget_accent" android:contentDescription="@null"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_internet" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/value_network" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/widget_on" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/sub_network" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cell_dns" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_tile">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/icon_dns" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_shield" android:tint="@color/widget_accent" android:contentDescription="@null"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_dns" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/value_dns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/widget_on" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/sub_dns" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
