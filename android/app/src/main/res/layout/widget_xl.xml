<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_widget_pc" android:contentDescription="@null"/>
        <TextView android:id="@+id/widget_headline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/widget_loading" android:textColor="@color/widget_on" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        <ImageView android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_widget_refresh" android:tint="@color/widget_on_variant" android:contentDescription="@string/widget_refresh"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="42dp" android:textColor="@color/widget_on_variant" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/gpu_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.6" android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_power" android:textColor="@color/widget_on_variant" android:textSize="13sp" android:maxLines="1"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/big_power" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/widget_on" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="5dp" android:text="W" android:textColor="@color/widget_on_variant" android:textSize="14sp" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_temp" android:textColor="@color/widget_on_variant" android:textSize="13sp" android:maxLines="1"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/big_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/widget_on" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="5dp" android:text="°C" android:textColor="@color/widget_on_variant" android:textSize="14sp" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_load" android:textColor="@color/widget_on_variant" android:textSize="13sp" android:maxLines="1"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/big_load" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/widget_on" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="5dp" android:text="%" android:textColor="@color/widget_on_variant" android:textSize="14sp" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_vram" android:textColor="@color/widget_on_variant" android:textSize="13sp" android:maxLines="1"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/big_vram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/widget_on" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="5dp" android:text="GB" android:textColor="@color/widget_on_variant" android:textSize="14sp" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_downloads" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.55" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_tile" android:minHeight="48dp">
        <ImageView android:id="@+id/icon_downloads" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_download" android:tint="@color/widget_on_variant" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/widget_downloads" android:textColor="@color/widget_on_variant" android:textSize="15sp" android:maxLines="1"/>
        <TextView android:id="@+id/value_downloads" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:gravity="end" android:text="—" android:textColor="@color/widget_on" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row_problems" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.55" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_tile" android:minHeight="48dp">
        <ImageView android:id="@+id/icon_problems" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_problem" android:tint="@color/widget_on_variant" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/widget_problems" android:textColor="@color/widget_on_variant" android:textSize="15sp" android:maxLines="1"/>
        <TextView android:id="@+id/value_problems" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:gravity="end" android:text="—" android:textColor="@color/widget_on" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/widget_on_variant" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
